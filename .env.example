# V1 runtime (Compose paths). Local instructions override DATABASE_URL/POLICY_FILE.
DATABASE_URL=sqlite:////data/intentlock.db
POLICY_FILE=policies/refunds.yaml
GRANT_ISSUER=
APP_ORIGIN=http://localhost:8080
# Human-approved signing only: configure ONE single-key source OR the file map.
GRANT_PRIVATE_KEY_FILE=
GRANT_PRIVATE_KEY_PEM=
GRANT_PRIVATE_KEY_PASSWORD=
GRANT_KEY_FILE_MAP=
# Direct grant/key CLI settings (the v1 server derives kid from the human session).
GRANT_SIGNING_KID=
# Legacy direct core-grant CLI only. V1 ignores this: it hashes POLICY_FILE.
POLICY_VERSION=
# Optional real model adapter / legacy offline human import/key utilities.
GATEWAY_URL=http://localhost:8000
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
SIGNING_KEY_PATH=
SIGNING_KEY_PASSWORD=

# Gateway-to-executor credential only (32+ random characters); never give to agent.
EXECUTOR_URL=http://localhost:8001
EXECUTOR_AUTH_TOKEN=
# Executor/reconciler ONLY: one actual merchant account bound to one tenant.
EXECUTOR_TENANT_ID=
RAZORPAY_ACCOUNT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Executor secrets may alternatively use NAME_FILE (0600/0400 regular files).

# Dedicated persistent Ed25519 receipt key, shared only by trusted writers.
# Choose exactly one PEM or protected file source; never reuse a grant key.
RECEIPT_PRIVATE_KEY_PEM=
RECEIPT_PRIVATE_KEY_FILE=
RECEIPT_PRIVATE_KEY_PASSWORD=

# Public intake: shared 32+ character HMAC secret for hashed client counters.
INTAKE_RATE_SECRET=
# Agent profile ONLY. Never inject signing, executor, provider or DB secrets here.
AGENT_SERVICE_KEY=
GEMINI_MODEL=
GEMINI_API_KEY=
# Optional trusted IMAP intake profile; uses receipt key but no grant/provider keys.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=
IMAP_CHANNEL_ID=

# Trusted provisioning CLI only; set real channel/tenant/service identifiers.
SUPPORT_CHANNEL_ID=
REAL_TENANT_ID=
AGENT_SERVICE_ID=
AGENT_ACTOR_ID=
AGENT_KEY_TTL=

# Trusted LIVE evaluator only; never pass these credentials to the agent.
EVAL_TENANT_ID=
EVAL_GATEWAY_URL=
EVAL_AGENT_SERVICE_KEY=
EVAL_OPERATOR_SESSION=
EVAL_CSRF_TOKEN=
EVAL_APP_ORIGIN=
EVAL_POLICY_FILE=
# Actual build SHA only, if git HEAD cannot be read.
EVAL_GIT_SHA=
# JSON mapping real tenant IDs to executor-local eval_probe argv arrays.
EVAL_PROVIDER_COMMANDS=

# Trusted gateway only: dedicated Fernet key file for durable approved-grant handoff.
# Generate once with python -m app.core.dispatch; mount the protected file in Compose.
DISPATCH_KEY_FILE=

# Gateway only: independent 32+ character HMAC secret for same-origin session resumption.
SESSION_CSRF_SECRET=

# Gateway only: Google Workspace or company OIDC, invite-only, RS256 ID tokens.
# Register APP_ORIGIN + /v1/auth/callback as the exact authorized redirect URI.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Configure exactly one: environment secret OR protected regular secret file.
OIDC_CLIENT_SECRET=
OIDC_CLIENT_SECRET_FILE=
OIDC_DISPLAY_NAME=

# Optional exact HTTPS origin for a public storefront; never a wildcard.
STORE_PUBLIC_ORIGIN=

# Existing active support channel deliberately published in the workspace header.
PUBLIC_STORE_CHANNEL=
# Optional canonical HTTPS origin for the protected generated Docker deployment.
DEPLOYMENT_ORIGIN=
