FROM python:3.12-slim
WORKDIR /agent
COPY requirements-agent.lock ./
RUN pip install --no-cache-dir -r requirements-agent.lock && useradd --uid 10002 --create-home agent
COPY app/__init__.py ./app/
COPY app/core/__init__.py app/core/canonical.py ./app/core/
COPY app/agent/__init__.py app/agent/contracts.py app/agent/gemini.py app/agent/worker.py ./app/agent/
COPY intentlock/__init__.py intentlock/schema.py ./intentlock/
USER agent
CMD ["python", "-m", "app.agent.worker"]
